    {
      "parameters": {
        "jsCode": "function faixaParaNumero(faixa) {\n  if (!faixa) return { min: null, max: null };\n\n  faixa = faixa.toLowerCase().trim();\n\n  switch (faixa) {\n    case \"entre 10 e 70\":\n      return { min: 10, max: 70 };\n\n    case \"entre 71 e 160\":\n      return { min: 71, max: 160 };\n\n    case \"entre 161 e 290\":\n      return { min: 161, max: 290 };\n\n    case \"entre 291 e 380\":\n      return { min: 291, max: 380 };\n\n    case \"maior que 380\":\n      return { min: 380, max: 99999 };\n\n    default:\n      return { min: null, max: null };\n  }\n}\n\nconst formsData = $(\"forms\").first().json;\n\nconst faixaTexto = formsData[\"Selecione a faixa de preço:\"];\nconst faixa = faixaParaNumero(faixaTexto);\n\nreturn $input.all().map(item => ({\n  json: {\n    ...item.json,\n    faixaMin: faixa.min,\n    faixaMax: faixa.max\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        864,
        -80
      ],
      "id": "b342dab1-b198-4cb0-be29-cacd0c6df8ea",
      "name": "Code in JavaScript"
